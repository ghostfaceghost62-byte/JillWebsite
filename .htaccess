<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent directory browsing
Options -Indexes

# Deny access to hidden dotfiles (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Deny public web access to sensitive configuration & metadata files
<FilesMatch "^(composer\.json|composer\.lock|\.env.*|README\.md|Dockerfile|render\.yaml)$">
    Require all denied
</FilesMatch>

# Prevent direct HTTP access to database migration files
<IfModule mod_rewrite.c>
    RewriteRule ^database/ - [F,L]
</IfModule>

